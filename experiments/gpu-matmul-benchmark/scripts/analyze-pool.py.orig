#!/usr/bin/env python3
"""Build per-job and pool-level timing reports from Kubernetes snapshots."""

from __future__ import annotations

import argparse
import csv
import json
import math
from datetime import datetime
from pathlib import Path
from typing import Any


EXPERIMENT_LABEL = "benchmark.thesis/experiment"
CLASS_LABEL = "benchmark.thesis/service-class"
PROFILE_LABEL = "benchmark.thesis/profile"
JSON_PREFIX = "BENCHMARK_JSON "


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser()
    parser.add_argument("run_dir", type=Path)
    parser.add_argument("--experiment", default="baseline-medium")
    return parser.parse_args()


def load_json(path: Path) -> dict[str, Any]:
    with path.open(encoding="utf-8") as handle:
        return json.load(handle)


def parse_timestamp(value: str | None) -> datetime | None:
    if not value:
        return None
    return datetime.fromisoformat(value.replace("Z", "+00:00"))


def seconds_between(start: datetime | None, end: datetime | None) -> float | None:
    if start is None or end is None:
        return None
    return (end - start).total_seconds()


def iso(value: datetime | None) -> str:
    return value.isoformat().replace("+00:00", "Z") if value else ""


def percentile(values: list[float], quantile: float) -> float | None:
    if not values:
        return None
    ordered = sorted(values)
    if len(ordered) == 1:
        return ordered[0]
    position = (len(ordered) - 1) * quantile
    lower = math.floor(position)
    upper = math.ceil(position)
    if lower == upper:
        return ordered[lower]
    fraction = position - lower
    return ordered[lower] + fraction * (ordered[upper] - ordered[lower])


def stats(values: list[float]) -> dict[str, float | int | None]:
    return {
        "count": len(values),
        "min_seconds": min(values) if values else None,
        "p50_seconds": percentile(values, 0.50),
        "p95_seconds": percentile(values, 0.95),
        "max_seconds": max(values) if values else None,
        "mean_seconds": sum(values) / len(values) if values else None,
    }


def job_owner(workload: dict[str, Any]) -> str | None:
    for owner in workload.get("metadata", {}).get("ownerReferences", []):
        if owner.get("kind") == "Job":
            return owner.get("name")
    return None


def admission_time(workload: dict[str, Any] | None) -> datetime | None:
    if not workload:
        return None
    conditions = workload.get("status", {}).get("conditions", [])
    for condition_type in ("Admitted", "QuotaReserved"):
        for condition in conditions:
            if condition.get("type") == condition_type and condition.get("status") == "True":
                return parse_timestamp(condition.get("lastTransitionTime"))
    return None


def benchmark_summary(log_path: Path) -> dict[str, Any] | None:
    if not log_path.exists():
        return None
    result = None
    with log_path.open(encoding="utf-8", errors="replace") as handle:
        for line in handle:
            if not line.startswith(JSON_PREFIX):
                continue
            try:
                event = json.loads(line[len(JSON_PREFIX) :])
            except json.JSONDecodeError:
                continue
            if event.get("event") == "benchmark_summary":
                result = event
    return result


def main() -> int:
    args = parse_args()
    run_dir = args.run_dir.resolve()
    jobs = load_json(run_dir / "jobs.json").get("items", [])
    pods = load_json(run_dir / "pods.json").get("items", [])
    workloads = load_json(run_dir / "workloads.json").get("items", [])

    jobs = [
        job
        for job in jobs
        if job.get("metadata", {}).get("labels", {}).get(EXPERIMENT_LABEL)
        == args.experiment
    ]
    pods_by_job: dict[str, dict[str, Any]] = {}
    for pod in pods:
        labels = pod.get("metadata", {}).get("labels", {})
        name = labels.get("batch.kubernetes.io/job-name") or labels.get("job-name")
        if name:
            pods_by_job[name] = pod
    workloads_by_job = {
        owner: workload
        for workload in workloads
        if (owner := job_owner(workload)) is not None
    }

    rows: list[dict[str, Any]] = []
    for job in sorted(jobs, key=lambda item: item["metadata"]["name"]):
        metadata = job.get("metadata", {})
        labels = metadata.get("labels", {})
        status = job.get("status", {})
        name = metadata["name"]
        pod = pods_by_job.get(name, {})
        workload = workloads_by_job.get(name)

        created = parse_timestamp(metadata.get("creationTimestamp"))
        admitted = admission_time(workload)
        pod_started = parse_timestamp(pod.get("status", {}).get("startTime"))
        completed = parse_timestamp(status.get("completionTime"))
        bench = benchmark_summary(run_dir / "logs" / f"{name}.log") or {}
        gpu = bench.get("gpu", {})

        rows.append(
            {
                "job_name": name,
                "service_class": labels.get(CLASS_LABEL, ""),
                "profile": labels.get(PROFILE_LABEL, ""),
                "created_at": iso(created),
                "admitted_at": iso(admitted),
                "pod_started_at": iso(pod_started),
                "completed_at": iso(completed),
                "queue_wait_seconds": seconds_between(created, admitted),
                "startup_seconds": seconds_between(admitted, pod_started),
                "execution_seconds": seconds_between(pod_started, completed),
                "end_to_end_seconds": seconds_between(created, completed),
                "gpu_cuda_seconds": bench.get("cuda_seconds_p50"),
                "gpu_wall_seconds": bench.get("wall_seconds_total"),
                "gpu_name": gpu.get("name"),
                "gpu_multiprocessors": gpu.get("multiprocessor_count"),
                "claim_template": bench.get("claim_template"),
                "succeeded": status.get("succeeded", 0),
                "failed": status.get("failed", 0),
            }
        )

    fieldnames = list(rows[0].keys()) if rows else []
    with (run_dir / "jobs.csv").open("w", encoding="utf-8", newline="") as handle:
        writer = csv.DictWriter(handle, fieldnames=fieldnames)
        if fieldnames:
            writer.writeheader()
            writer.writerows(rows)

    created_values = [parse_timestamp(row["created_at"]) for row in rows]
    completed_values = [parse_timestamp(row["completed_at"]) for row in rows]
    created_values = [value for value in created_values if value]
    completed_values = [value for value in completed_values if value]
    pool_start = min(created_values) if created_values else None
    pool_end = max(completed_values) if completed_values else None
    makespan = seconds_between(pool_start, pool_end)

    classes: dict[str, Any] = {}
    for service_class in sorted({str(row["service_class"]) for row in rows}):
        class_rows = [row for row in rows if row["service_class"] == service_class]
        classes[service_class] = {
            "jobs": len(class_rows),
            "completed": sum(1 for row in class_rows if row["succeeded"] == 1),
            "end_to_end": stats(
                [float(row["end_to_end_seconds"]) for row in class_rows if row["end_to_end_seconds"] is not None]
            ),
            "queue_wait": stats(
                [float(row["queue_wait_seconds"]) for row in class_rows if row["queue_wait_seconds"] is not None]
            ),
            "execution": stats(
                [float(row["execution_seconds"]) for row in class_rows if row["execution_seconds"] is not None]
            ),
            "gpu_cuda": stats(
                [float(row["gpu_cuda_seconds"]) for row in class_rows if row["gpu_cuda_seconds"] is not None]
            ),
        }

    report = {
        "schema_version": "1.0",
        "experiment_arm": args.experiment,
        "jobs_submitted": len(rows),
        "jobs_completed": sum(1 for row in rows if row["succeeded"] == 1),
        "jobs_failed": sum(1 for row in rows if row["failed"]),
        "pool_start": iso(pool_start),
        "pool_end": iso(pool_end),
        "submission_span_seconds": seconds_between(
            min(created_values) if created_values else None,
            max(created_values) if created_values else None,
        ),
        "makespan_seconds": makespan,
        "throughput_jobs_per_second": len(rows) / makespan if makespan and makespan > 0 else None,
        "device_distribution_by_class_and_sm": device_distribution,
        "classes": classes,
        "definitions": {
            "makespan_seconds": "max(Job completionTime) - min(Job creationTimestamp)",
            "queue_wait_seconds": "Workload admitted time - Job creationTimestamp",
            "startup_seconds": "Pod startTime - Workload admitted time",
            "execution_seconds": "Job completionTime - Pod startTime",
            "end_to_end_seconds": "Job completionTime - Job creationTimestamp",
        },
    }
    with (run_dir / "summary.json").open("w", encoding="utf-8") as handle:
        json.dump(report, handle, indent=2)
        handle.write("\n")

    print(json.dumps(report, indent=2))
    if report["jobs_completed"] != report["jobs_submitted"] or report["jobs_submitted"] == 0:
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
